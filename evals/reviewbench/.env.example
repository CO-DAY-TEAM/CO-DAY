# 이 파일을 같은 폴더의 .env로 복사합니다. 저장소 루트 .env는 자동으로 읽지 않습니다.
REVIEW_API_KEY=
REVIEW_MODEL=gpt-5-mini
REVIEW_BASE_URL=https://api.openai.com/v1

# 심사는 pi의 ChatGPT Plus/Pro (Codex) OAuth 로그인을 사용합니다.
# 최초 한 번 run.py --login을 실행합니다. 심사용 API 키는 사용하지 않습니다.
JUDGE_MODEL=gpt-5.4
JUDGE_CONCURRENCY=2

LANGFUSE_BASE_URL=http://34.64.136.186:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 실험 이름: 목적-한국시간-실행자-고유값 (예: baseline-20261027-193000-member1-a1b2c3)
RUN_BY=member1
RUN_LABEL=baseline
RUN_DESCRIPTION=현재 리뷰 로직과 프롬프트의 기준 성능 측정
